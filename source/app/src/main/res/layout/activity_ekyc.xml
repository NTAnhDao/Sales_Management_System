<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/gray"
    android:fitsSystemWindows="true"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingVertical="8dp"
        android:layout_marginHorizontal="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:clickable="true"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            android:layout_marginEnd="12dp"
            app:tint="@color/blue"
            android:background="@color/white"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:text="Cập nhật sinh trắc học"
            android:textColor="@color/blue"
            android:textSize="22sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Overlay vùng nhận diện khuôn mặt -->
    <FrameLayout
        android:id="@+id/faceFrame"
        android:layout_width="match_parent"
        android:layout_height="500dp"
        android:layout_gravity="center"
        android:background="@drawable/ekyc_frame"
        android:padding="10dp"
        android:layout_marginHorizontal="16dp">

        <!-- Camera Preview -->
        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/ekyc_frame"/>
        <TextView
            android:id="@+id/timerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10"
            android:textSize="60sp"
            android:textStyle="bold"
            android:textColor="#58FFFFFF"
            android:layout_gravity="center"
            android:visibility="gone"/>
        <!-- Scan line -->
        <View
            android:id="@+id/scanLine"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/scan_line_shape" />
    </FrameLayout>

    <!-- Hướng dẫn -->
    <TextView
        android:id="@+id/txtGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:text="Giữ khuôn mặt trong khung và nhìn thẳng"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:padding="10dp"
        android:textAlignment="center"
        android:layout_weight="1"/>

    <Button
        android:id="@+id/btnReTakePhoto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chụp lại"
        android:backgroundTint="@color/blue"
        android:textColor="#FFFFFF"
        android:padding="14dp"
        android:textSize="16sp"
        android:layout_marginBottom="5dp"
        android:layout_marginHorizontal="16dp"/>

    <!-- Nút lưu -->
    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lưu eKYC"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"
        android:padding="14dp"
        android:textSize="16sp"
        android:layout_marginBottom="10dp"
        android:layout_marginHorizontal="16dp"/>

</LinearLayout>
