<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:layout_margin="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:clickable="true"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            android:layout_marginEnd="12dp"
            app:tint="@color/blue"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:text="Thêm tài khoản ngân hàng"
            android:textColor="@color/blue"
            android:textSize="22sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <Spinner
        android:id="@+id/spnAccountType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="10dp"
        android:textColor="@color/black"/>

   <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Số tài khoản"
        android:layout_marginTop="5dp"
        android:textColor="@color/black"
        android:textSize="16sp"/>
    <EditText
        android:id="@+id/edtAccountNumber"
        android:hint="Số tài khoản"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColorHint="@color/black"
        android:inputType="number"
        android:textColor="@color/black"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Số dư khởi tạo"
        android:layout_marginTop="10dp"
        android:textColor="@color/black"
        android:textSize="16sp"/>
    <EditText
        android:id="@+id/edtBalance"
        android:hint="Số dư khởi tạo"
        android:inputType="number"
        android:textColorHint="@color/black"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/black"/>

    <RadioGroup
        android:id="@+id/rgPaymentMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbMonthly"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trả theo tháng"
            android:layout_marginEnd="10dp"
            android:textColor="@color/black"/>

        <RadioButton
            android:id="@+id/rbBiweekly"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trả mỗi 2 tuần"
            android:textColor="@color/black"/>
    </RadioGroup>

    <Button
        android:id="@+id/btnAddAccount"
        android:text="Thêm tài khoản"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:backgroundTint="@color/blue"
        android:layout_marginVertical="10dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lưu ý: Đối với tài khoản vay, ngân hàng áp dụng chính sách lãi 10%/năm với số năm vay mặc định là 2 năm."
        android:layout_marginVertical="10dp"
        android:textColor="@color/black"/>/>


</LinearLayout>