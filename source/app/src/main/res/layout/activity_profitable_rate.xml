<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray"
    android:layout_margin="16dp">
    <TextView
        android:id="@+id/txtTitle"
        android:text="Quản lý lãi suất"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/blue"
        android:layout_marginBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"/>

    <!-- Sub Description -->
    <TextView
        android:id="@+id/txtDescription"
        android:text="Nhân viên có thể sửa đổi và cập nhật tỷ giá có lợi nhuận hiện tại dựa trên chính sách của ngân hàng."
        android:textSize="16sp"
        android:layout_marginBottom="20dp"
        android:layout_width="match_parent"
        android:textColor="@color/black"
        android:layout_height="wrap_content" />
    <TextView
        android:id="@+id/txtCurrentRate"
        android:text="Lãi suất hiện tại: --%"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:paddingVertical="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <EditText
        android:id="@+id/edtRate"
        android:hint="Nhập lãi suất mới"
        android:inputType="numberDecimal"
        android:padding="10dp"
        android:textColorHint="@color/black"
        android:textColor="@color/black"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/btnSave"
        android:text="Lưu"
        android:layout_marginTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:backgroundTint="@color/blue"/>
    <TextView
        android:id="@+id/txtFooter"
        android:text="Lưu ý: Mọi thay đổi về lãi suất sẽ được áp dụng ngay lập tức."
        android:layout_marginTop="25dp"
        android:textSize="14sp"
        android:textColor="@color/red"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
