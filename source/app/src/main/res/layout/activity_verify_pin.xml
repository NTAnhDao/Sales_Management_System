<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gray"
    android:gravity="center"
    android:padding="24dp">

    <ImageView
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@drawable/ic_contact_mail_"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:id="@+id/txtTimerPin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⏳ 05:00"
        android:textSize="30sp"
        android:textColor="#FF0000"
        android:layout_marginBottom="20dp"/>


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Nhập mã PIN"
        android:textColor="#000000"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtPhone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quý khách vui lòng nhập mã PIN của quý khách"
        android:textSize="16sp"
        android:textColor="#555555"
        android:layout_marginBottom="24dp"/>


    <LinearLayout
        android:id="@+id/layoutOtp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="40dp"
        android:layout_gravity="center">

        <EditText
            android:id="@+id/otp1"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:textColor="@color/black"
            android:background="@drawable/bg_otp_box"
            android:inputType="number"
            android:maxLength="1"
            android:textSize="18sp"
            android:imeOptions="actionNext"
            android:importantForAutofill="no"/>

        <EditText
            android:id="@+id/otp2"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:textColor="@color/black"
            android:background="@drawable/bg_otp_box"
            android:inputType="number"
            android:maxLength="1"
            android:textSize="18sp"
            android:layout_marginStart="8dp"
            android:imeOptions="actionNext"
            android:importantForAutofill="no"/>

        <EditText
            android:id="@+id/otp3"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:textColor="@color/black"
            android:background="@drawable/bg_otp_box"
            android:inputType="number"
            android:maxLength="1"
            android:textSize="18sp"
            android:layout_marginStart="8dp"
            android:imeOptions="actionNext"
            android:importantForAutofill="no"/>

        <EditText
            android:id="@+id/otp4"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:textColor="@color/black"
            android:background="@drawable/bg_otp_box"
            android:inputType="number"
            android:maxLength="1"
            android:textSize="18sp"
            android:layout_marginStart="8dp"
            android:imeOptions="actionNext"
            android:importantForAutofill="no"/>

        <EditText
            android:id="@+id/otp5"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:textColor="@color/black"
            android:background="@drawable/bg_otp_box"
            android:inputType="number"
            android:maxLength="1"
            android:textSize="18sp"
            android:layout_marginStart="8dp"
            android:imeOptions="actionNext"
            android:importantForAutofill="no"/>

        <EditText
            android:id="@+id/otp6"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:textColor="@color/black"
            android:background="@drawable/bg_otp_box"
            android:inputType="number"
            android:maxLength="1"
            android:textSize="18sp"
            android:layout_marginStart="8dp"

            android:importantForAutofill="no"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnVerifyPIN"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tiếp tục"
        android:backgroundTint="@color/blue"
        android:textColor="#FFFFFF"
        android:textAllCaps="true"
        android:layout_marginBottom="50dp"
        android:layout_marginHorizontal="20dp"/>
</LinearLayout>
